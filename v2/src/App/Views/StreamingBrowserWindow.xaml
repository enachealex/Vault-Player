<Window x:Class="VideoPlayer.App.Views.StreamingBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VideoPlayer.App.Helpers"
        ui:Glass.Window="True"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Streaming"
        Width="1180" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackBtn" Style="{StaticResource GhostButton}" Padding="10,6"
                            Content="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            Click="Back_Click" ToolTip="Back" AutomationProperties.Name="Back" />
                    <Button x:Name="ForwardBtn" Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0"
                            Content="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            Click="Forward_Click" ToolTip="Forward" AutomationProperties.Name="Forward" />
                    <Button x:Name="ReloadBtn" Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0"
                            Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            Click="Reload_Click" ToolTip="Reload" AutomationProperties.Name="Reload" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <!-- Streaming sites are heavy and their first load can take
                         ten seconds or more, most of it before anything is
                         painted. Without a sign that work is happening, a slow
                         page and a broken one look identical. -->
                    <TextBlock x:Name="BusyDots" Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource AccentBrush}" Visibility="Collapsed">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="BusySpin" CenterX="6" CenterY="7" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="PageTitle" VerticalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Text="Loading…" />
                </StackPanel>

                <Button x:Name="HandoffBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="14,7"
                        Click="Handoff_Click"
                        ToolTip="Open this page in your normal browser, where protected video can play"
                        AutomationProperties.Name="Watch in my browser">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Watch in my browser" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Shown on a DRM player page, where embedded playback can't work -->
        <ProgressBar x:Name="LoadBar" Grid.Row="0" VerticalAlignment="Bottom" Height="2"
                     IsIndeterminate="True" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource AccentBrush}" />

        <Border x:Name="DrmBar" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource TextBrush}"
                           Text="This title is DRM-protected, so it can't play inside Vault Movies. Open it in your browser and it'll play there at full quality." />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="12,0,0,0"
                        Content="Open in my browser" Click="Handoff_Click"
                        AutomationProperties.Name="Open in my browser" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <wv2:WebView2 x:Name="Web" />

            <!-- Runtime missing / failed to start -->
            <Border x:Name="FailPanel" Visibility="Collapsed" Background="{StaticResource BgBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="40"
                               Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="The in-app browser isn't available" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               Margin="0,14,0,6" />
                    <TextBlock x:Name="FailText" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="Your normal browser works fine for this." />
                    <Button Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Content="Open in my browser" Click="Handoff_Click"
                            AutomationProperties.Name="Open in my browser instead" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
