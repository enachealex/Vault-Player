<Window x:Class="VideoPlayer.App.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VideoPlayer.App.Helpers"
        ui:Glass.Window="True"
        xmlns:v="clr-namespace:VideoPlayer.App.Views"
        Title="Account"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Text="Sign in" FontSize="19" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="Subhead" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,18" />

        <TextBlock x:Name="ErrorText" Text="" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12" Visibility="Collapsed" />

        <!-- Sign in / Register -->
        <StackPanel x:Name="FormPanel">
            <TextBlock Text="USERNAME" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,4">
                <TextBox x:Name="UsernameBox" Style="{StaticResource FieldText}" MaxLength="20"
                         AutomationProperties.Name="Username" />
            </Border>
            <TextBlock x:Name="UsernameHint" Text="3–20 characters: letters, digits, dots, dashes, underscores."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10"
                       Visibility="Collapsed" />

            <TextBlock Text="PASSWORD" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,6" />
            <v:PasswordField x:Name="PassField" FieldName="Password" />
            <TextBlock x:Name="PassHint" Text="At least 8 characters." FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0" Visibility="Collapsed" />

            <!-- Create-account only -->
            <StackPanel x:Name="ConfirmRow" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="CONFIRM PASSWORD" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                <v:PasswordField x:Name="ConfirmField" FieldName="Confirm password" />
            </StackPanel>

            <StackPanel x:Name="EmailRow" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="EMAIL — OPTIONAL" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                <Border Style="{StaticResource FieldBox}">
                    <TextBox x:Name="EmailBox" Style="{StaticResource FieldText}"
                             AutomationProperties.Name="Email (optional)" />
                </Border>
                <TextBlock Text="Only used if you ever need to reset your password."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0" />
            </StackPanel>

            <StackPanel x:Name="InviteRow" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="INVITE CODE — OPTIONAL" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                <Border Style="{StaticResource FieldBox}">
                    <TextBox x:Name="InviteBox" Style="{StaticResource FieldText}" MaxLength="14"
                             FontFamily="Consolas" CharacterCasing="Upper"
                             AutomationProperties.Name="Invite code (optional)" />
                </Border>
                <TextBlock Text="Got one from the library owner? It unlocks their films immediately. Without it, you'll wait for their approval."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Are-you-human check, drawn by our own server -->
            <StackPanel x:Name="CaptchaRow" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="TYPE THE CHARACTERS" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" Height="52" Background="#F4EEE4">
                        <Image x:Name="CaptchaImage" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="10,0"
                            Margin="8,0,0,0" Click="RefreshCaptcha_Click" ToolTip="Get a different image"
                            AutomationProperties.Name="New captcha image">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                </Grid>
                <Border Style="{StaticResource FieldBox}" Margin="0,8,0,0">
                    <TextBox x:Name="CaptchaBox" Style="{StaticResource FieldText}" MaxLength="5"
                             FontSize="16" FontFamily="Consolas" CharacterCasing="Upper"
                             AutomationProperties.Name="Captcha answer" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="ForgotLink" Content="Forgot password?" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Click="Forgot_Click"
                        AutomationProperties.Name="Forgot password" />
                <Button x:Name="PhoneLink" Content="Sign in with your phone" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="16,0,0,0" Click="PhoneSignIn_Click"
                        AutomationProperties.Name="Sign in with your phone" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="ToggleBtn" Content="Create account" Style="{StaticResource GhostButton}"
                        Padding="12,7" Margin="0,0,10,0" Click="Toggle_Click"
                        AutomationProperties.Name="Switch mode" />
                <Button x:Name="SubmitBtn" Content="Sign in" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" Click="Submit_Click" IsDefault="True"
                        AutomationProperties.Name="Submit" />
            </StackPanel>
        </StackPanel>

        <!-- Device-link: scan, sign in on the phone, type the code here -->
        <StackPanel x:Name="PhonePanel" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Center">
                <Image x:Name="LinkQrImage" Width="180" Height="180"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock x:Name="LinkUrlText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="Scan with your phone, sign in there, then type the code it gives you:"
                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,12,0,6" />
            <Border Style="{StaticResource FieldBox}">
                <TextBox x:Name="LinkCodeBox" Style="{StaticResource FieldText}" MaxLength="6"
                         FontSize="20" FontFamily="Consolas" CharacterCasing="Upper"
                         AutomationProperties.Name="Link code" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Back" Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,10,0"
                        Click="Back_Click" AutomationProperties.Name="Back" />
                <Button x:Name="LinkClaimBtn" Content="Sign in" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" Click="LinkClaim_Click" IsDefault="True"
                        AutomationProperties.Name="Sign in with code" />
            </StackPanel>
        </StackPanel>

        <!-- Forgot password: request a code -->
        <StackPanel x:Name="ForgotPanel" Visibility="Collapsed">
            <TextBlock Text="EMAIL" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
            <Border Style="{StaticResource FieldBox}">
                <TextBox x:Name="ForgotEmailBox" Style="{StaticResource FieldText}"
                         AutomationProperties.Name="Email for reset" />
            </Border>
            <TextBlock Text="Works only if you added an email to your account."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Back" Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,10,0"
                        Click="Back_Click" AutomationProperties.Name="Back" />
                <Button x:Name="SendCodeBtn" Content="Send code" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" Click="SendCode_Click" IsDefault="True"
                        AutomationProperties.Name="Send code" />
            </StackPanel>
        </StackPanel>

        <!-- Reset: code + new password -->
        <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
            <TextBlock Text="CODE" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,14">
                <TextBox x:Name="ResetCodeBox" Style="{StaticResource FieldText}" MaxLength="6"
                         FontFamily="Consolas" AutomationProperties.Name="Reset code" />
            </Border>
            <TextBlock Text="NEW PASSWORD" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
            <v:PasswordField x:Name="ResetField" FieldName="New password" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Back" Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,10,0"
                        Click="Back_Click" AutomationProperties.Name="Back" />
                <Button x:Name="ResetBtn" Content="Reset password" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" Click="Reset_Click" IsDefault="True"
                        AutomationProperties.Name="Reset password" />
            </StackPanel>
        </StackPanel>

        <!-- Signed in -->
        <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="WhoName" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="WhoEmail" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock x:Name="StatusLine" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="SyncStatus" FontSize="12" Foreground="{StaticResource AccentWarmBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Button x:Name="FriendsBtn" Style="{StaticResource GhostButton}" Padding="14,9" Margin="0,12,0,0"
                    HorizontalAlignment="Stretch" Click="Friends_Click"
                    AutomationProperties.Name="Manage friends">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="FriendsBtnLabel" Text="Friends" FontSize="13" />
                </StackPanel>
            </Button>

            <!-- Owner only: who may stream the server's films -->
            <Button x:Name="ManageUsersBtn" Style="{StaticResource GhostButton}" Padding="14,9" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch" Click="ManageUsers_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Manage users">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ManageUsersLabel" Text="Manage users" FontSize="13" />
                </StackPanel>
            </Button>

            <Button x:Name="DeleteLink" Content="Delete account" Style="{StaticResource LinkButton}"
                    Foreground="{StaticResource DangerBrush}"
                    HorizontalAlignment="Left" Margin="2,14,0,0" Click="Delete_Click"
                    AutomationProperties.Name="Delete account" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Sign out" Style="{StaticResource GhostButton}" Padding="14,7"
                        Margin="0,0,10,0" Click="SignOut_Click" AutomationProperties.Name="Sign out" />
                <Button Content="Done" Style="{StaticResource PrimaryButton}" Padding="18,7"
                        Click="Done_Click" IsDefault="True" AutomationProperties.Name="Done" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
