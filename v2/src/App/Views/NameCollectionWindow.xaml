<Window x:Class="VideoPlayer.App.Views.NameCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New collection" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Name this collection"
                   Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="Only you see your collections. Anyone signed in with your account sees the same ones."
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,6,0,16" />

        <TextBox x:Name="NameBox" MaxLength="60" FontSize="14" Padding="10,8"
                 KeyDown="NameBox_KeyDown" AutomationProperties.Name="Collection name" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12"
                   Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="16,8"
                    Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="CreateBtn" Content="Create" Padding="18,8" IsDefault="True" Click="Create_Click" />
        </StackPanel>
    </StackPanel>
</Window>
