<Window x:Class="VideoPlayer.App.Views.InviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VideoPlayer.App.Helpers"
        ui:Glass.Window="True"
        Title="Invite a friend"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">
    <StackPanel Margin="24">
        <TextBlock Text="Invite a friend" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                   Margin="0,6,0,16"
                   Text="They scan this with their phone — it explains everything and carries the code. Registering with it unlocks your films immediately, no approval step. One use, expires in a week." />

        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10" Visibility="Collapsed" />

        <!-- The QR itself, on white: scanners want contrast, not theming. -->
        <Border Background="White" CornerRadius="12" Padding="14" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="220" Height="220"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                   Margin="0,14,0,2" />
        <TextBlock x:Name="ExpiryText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="Copy code" Style="{StaticResource GhostButton}" Padding="12,7"
                    Margin="0,0,8,0" Click="CopyCode_Click" AutomationProperties.Name="Copy code" />
            <Button Content="Copy link" Style="{StaticResource GhostButton}" Padding="12,7"
                    Margin="0,0,8,0" Click="CopyLink_Click" AutomationProperties.Name="Copy link" />
            <Button Content="New invite" Style="{StaticResource GhostButton}" Padding="12,7"
                    Click="NewInvite_Click" AutomationProperties.Name="New invite" />
        </StackPanel>

        <!-- Older invites, so a code can be chased or killed -->
        <TextBlock Text="RECENT INVITES" FontSize="10.5" FontWeight="Bold"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,18,0,6" />
        <ItemsControl x:Name="InviteList" MaxHeight="150">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="12.5"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Grid.Column="2" Content="Revoke" Style="{StaticResource LinkButton}"
                                FontSize="11.5" Click="Revoke_Click" Tag="{Binding}"
                                Visibility="{Binding RevokeVisible}"
                                AutomationProperties.Name="Revoke invite" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Done" Style="{StaticResource PrimaryButton}" Padding="18,7"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Done_Click" IsDefault="True"
                AutomationProperties.Name="Done" />
    </StackPanel>
</Window>
