<UserControl x:Class="VideoPlayer.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:VideoPlayer.App.Models"
             xmlns:local="clr-namespace:VideoPlayer.App.Views"
             PreviewKeyDown="Library_PreviewKeyDown">
    <!-- The library as a television home screen: a featured film across the
         top, glass tabs over it, rows of stills that scroll sideways, and a
         details sheet over a blurred copy of the still. The same layout as the
         TV page and the phone app, so the three read as one product.

         Local films (from the chosen folder) and Vault films (from the server)
         share every page. A local film has no tidy title, year or arrival date,
         so it shows its file name and its own frame grab, and is simply never
         flagged NEW or featured as new. -->
    <UserControl.Resources>
        <!-- One menu per tile (x:Shared), so each knows the film it was opened
             on. Items show and hide per film in CardMenu_Opened. -->
        <ContextMenu x:Key="TileMenu" x:Shared="False" Opened="CardMenu_Opened">
            <MenuItem Header="Upload to Vault" Click="UploadToVault_Click"
                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Remove shortcut" Click="RemoveShortcut_Click"
                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <!-- Filled in per-open by CardMenu_Opened, because the shelves and
                 which ones already hold this film both change. -->
            <MenuItem Header="Add to collection"
                      Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- What is drawn on a tile: the still, the title written on it over a
             shade, the NEW flag, and the progress line. -->
        <DataTemplate x:Key="TileFace" DataType="{x:Type models:MovieItem}">
            <Grid>
                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="28"
                           Foreground="{StaticResource TextFaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18" />
                <Border CornerRadius="{StaticResource TileRadius}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="{StaticResource TileRadius}" Background="{StaticResource TileShadeBrush}" />
                <Border Style="{StaticResource NewFlag}" Visibility="{Binding NewFlagVisibility}">
                    <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
                <!-- Streaming shortcut: launches the service, never plays here. -->
                <Border Style="{StaticResource PosterChip}" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding ShortcutBadgeVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B5;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentWarmBrush}" />
                        <TextBlock Text="{Binding Service}" FontSize="10.5" Margin="6,0,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentWarmBrush}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxHeight="34"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="10,0,10,15">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
                <ProgressBar Style="{StaticResource TileProgress}" Value="{Binding ProgressFraction, Mode=OneWay}"
                             Visibility="{Binding ProgressVisibility}" />
            </Grid>
        </DataTemplate>

        <!-- A tile in a sideways row: fixed size. -->
        <DataTemplate x:Key="RowTile" DataType="{x:Type models:MovieItem}">
            <Button Style="{StaticResource StillTile}" Content="{Binding}" ContentTemplate="{StaticResource TileFace}"
                    Click="Tile_Click" MouseEnter="MovieCard_Hover" GotKeyboardFocus="MovieCard_Hover"
                    ContextMenu="{StaticResource TileMenu}" ToolTip="{Binding DisplayTitle}"
                    Tag="{Binding}" AutomationProperties.Name="{Binding DisplayTitle}" />
        </DataTemplate>

        <!-- A tile in a grid page: sized so whole columns fill the width. -->
        <DataTemplate x:Key="GridTile" DataType="{x:Type models:MovieItem}">
            <Button Style="{StaticResource StillTile}" Content="{Binding}" ContentTemplate="{StaticResource TileFace}"
                    Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding CardFrameHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="0,0,16,16"
                    Click="Tile_Click" MouseEnter="MovieCard_Hover" GotKeyboardFocus="MovieCard_Hover"
                    ContextMenu="{StaticResource TileMenu}" ToolTip="{Binding DisplayTitle}"
                    Tag="{Binding}" AutomationProperties.Name="{Binding DisplayTitle}" />
        </DataTemplate>

        <!-- "More from your vault" on the details sheet: smaller, and no hover
             backdrop change (the sheet already has the film behind it). -->
        <DataTemplate x:Key="SmallTile" DataType="{x:Type models:MovieItem}">
            <Button Style="{StaticResource StillTile}" Content="{Binding}" ContentTemplate="{StaticResource TileFace}"
                    Width="196" Height="110" Margin="0,0,12,12"
                    Click="Tile_Click" ToolTip="{Binding DisplayTitle}"
                    Tag="{Binding}" AutomationProperties.Name="{Binding DisplayTitle}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- One row on the Home page. The arrows sit over the row's ends and
             appear while the pointer is on it (Row_MouseEnter); the scroll bar
             is hidden, since the wheel, the arrows and the keyboard all move it. -->
        <DataTemplate DataType="{x:Type local:BrowseRow}">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding Title}" Style="{StaticResource RowHeader}" Margin="48,0,0,2" />
                <Grid Background="Transparent" MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave">
                    <ScrollViewer x:Name="RowScroll" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False"
                                  ScrollChanged="Row_ScrollChanged" PreviewMouseWheel="Row_PreviewMouseWheel">
                        <!-- Headroom above and below for a tile that grows, and
                             the page gutter on the left so the row starts in line
                             with the headings. -->
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RowTile}"
                                      ItemsPanel="{StaticResource RowPanel}" Margin="48,8,36,10"
                                      Focusable="False" />
                    </ScrollViewer>
                    <Button x:Name="PrevArrow" Style="{StaticResource RowArrow}" Content="&#xE76B;"
                            HorizontalAlignment="Left" Margin="4,8,0,10" Click="RowArrow_Click"
                            Tag="{Binding ElementName=RowScroll}" ToolTip="Scroll back"
                            AutomationProperties.Name="Scroll row back" />
                    <Button x:Name="NextArrow" Style="{StaticResource RowArrow}" Content="&#xE76C;"
                            HorizontalAlignment="Right" Margin="0,8,4,10" Click="RowArrow_Click"
                            Tag="{Binding ElementName=RowScroll}" ToolTip="Scroll on"
                            AutomationProperties.Name="Scroll row on" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A party keeps running while you browse, so it needs to be visible
             and endable from here rather than silently alive in the background. -->
        <Border x:Name="PartyBanner" Grid.Row="0" Visibility="Collapsed"
                Background="{StaticResource AccentSoftBrush}" BorderBrush="#66005ED9" BorderThickness="1"
                CornerRadius="{StaticResource BarRadius}" Padding="18,8,8,8" Margin="48,10,48,4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               VerticalAlignment="Center" Foreground="{StaticResource AccentLightBrush}" />
                    <TextBlock x:Name="PartyBannerText" Text="" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="Return to party"
                            FontSize="12.5" Padding="14,6" Click="ReturnToParty_Click"
                            ToolTip="Go back to the film your party is watching" AutomationProperties.Name="Return to party" />
                    <Button Style="{StaticResource GhostButton}" Content="Leave party"
                            FontSize="12.5" Padding="12,6" Margin="8,0,0,0" Click="LeaveParty_Click"
                            ToolTip="End your party and stop sharing" AutomationProperties.Name="Leave party" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown only when choosing a film to host, so it is obvious that
             clicking a still starts a party rather than playing it here. -->
        <Border x:Name="PickModeBanner" Grid.Row="0" Visibility="Collapsed"
                Background="{StaticResource AccentSoftBrush}" BorderBrush="#66005ED9" BorderThickness="1"
                CornerRadius="{StaticResource BarRadius}" Padding="18,11" Margin="48,10,48,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           VerticalAlignment="Center" Foreground="{StaticResource AccentLightBrush}" />
                <TextBlock Text="Pick a film to host — everyone in the party watches this"
                           FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" x:Name="Pages" ClipToBounds="True" SizeChanged="Pages_SizeChanged">

            <!-- ================= Home ================= -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" ScrollChanged="Page_ScrollChanged">
                <StackPanel>
                    <!-- The featured film. Two picture layers so one film can
                         fade into the next; the shades keep the title readable
                         on any frame and melt the still into the rows. -->
                    <Grid x:Name="Hero" Height="500" Visibility="Collapsed" ClipToBounds="True">
                        <!-- The picture and its shades fade out at the foot
                             rather than ending on a colour, so the still melts
                             into whatever film is behind the window instead of
                             stopping at a line. -->
                        <Grid OpacityMask="{StaticResource HeroFadeMaskBrush}">
                            <!-- Their own grid, so the z-order the cross-fade
                                 juggles stays beneath the shades. -->
                            <Grid>
                                <Image x:Name="HeroArtA" Stretch="UniformToFill" Opacity="0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image x:Name="HeroArtB" Stretch="UniformToFill" Opacity="0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <Rectangle Fill="{StaticResource HeroLeftShadeBrush}" />
                            <Rectangle Fill="{StaticResource HeroBottomShadeBrush}" />
                        </Grid>

                        <StackPanel x:Name="HeroCopy" Margin="48,92,0,0" MaxWidth="600"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock x:Name="HeroKicker" Style="{StaticResource Kicker}" Text="From your vault" />
                            <TextBlock x:Name="HeroTitleText" Style="{StaticResource HeroTitle}" Text="" MaxHeight="156"
                                       TextTrimming="WordEllipsis" />
                            <StackPanel x:Name="HeroMeta" Orientation="Horizontal" Margin="0,16,0,22" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="HeroPlayBtn" Style="{StaticResource HeroPrimaryButton}" Click="HeroPlay_Click"
                                        AutomationProperties.Name="Play featured film">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock x:Name="HeroPlayText" Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HeroGlassButton}" Margin="12,0,0,0" Click="HeroInfo_Click"
                                        ToolTip="Details, My List and more like it"
                                        AutomationProperties.Name="More info about the featured film">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="More info" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- Which of the featured films this is. Clickable, so
                                 a film that rotated away can be brought back. -->
                            <StackPanel x:Name="HeroDots" Orientation="Horizontal" Margin="2,22,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- The rows, pulled up over the foot of the featured still. -->
                    <ItemsControl x:Name="RowsList" Margin="0,-128,0,24" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Films ================= -->
            <ScrollViewer x:Name="FilmsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                          ScrollChanged="Page_ScrollChanged">
                <StackPanel Margin="48,84,32,24">
                    <Grid Margin="0,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FolderTitle" Text="Films" Style="{StaticResource PageTitle}" FontSize="30" />
                                <TextBlock x:Name="FilterCount" Text="" FontSize="13" Margin="12,0,0,5"
                                           VerticalAlignment="Bottom" Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="FolderSubtitle" Text="" FontSize="12.5" Margin="1,2,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Shelves. Hidden until the account has one, so a
                                 library nobody has organised has no empty picker. -->
                            <TextBlock x:Name="CollectionIcon" Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                       Margin="4,0,8,0" Visibility="Collapsed" />
                            <ComboBox x:Name="CollectionBox" ToolTip="Show only the films on one of your collections"
                                      Width="180" Margin="0,0,14,0" Visibility="Collapsed"
                                      SelectionChanged="CollectionBox_SelectionChanged"
                                      AutomationProperties.Name="Collection" />
                            <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                       Margin="4,0,8,0" />
                            <ComboBox x:Name="SortBox" ToolTip="Change the order films are listed in" Width="180"
                                      SelectionChanged="SortBox_SelectionChanged"
                                      AutomationProperties.Name="Sort order" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="MovieList" ItemTemplate="{StaticResource GridTile}"
                                  ItemsPanel="{StaticResource GridPanel}" Margin="0,0,-16,0"
                                  Focusable="False" SizeChanged="Grid_SizeChanged" />
                    <TextBlock x:Name="FilmsEmpty" Visibility="Collapsed" FontSize="14" Margin="0,30,0,0"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= My List ================= -->
            <ScrollViewer x:Name="MyListPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                          ScrollChanged="Page_ScrollChanged">
                <StackPanel Margin="48,84,32,24">
                    <TextBlock Text="My List" Style="{StaticResource PageTitle}" FontSize="30" Margin="0,0,0,18" />
                    <ItemsControl x:Name="MyListList" ItemTemplate="{StaticResource GridTile}"
                                  ItemsPanel="{StaticResource GridPanel}" Margin="0,0,-16,0"
                                  Focusable="False" SizeChanged="Grid_SizeChanged" />
                    <TextBlock x:Name="MyListEmpty" Visibility="Collapsed" FontSize="14" Margin="0,10,0,0"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="520"
                               HorizontalAlignment="Left"
                               Text="Nothing saved yet. Open any film and choose My List to keep it here." />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Search ================= -->
            <ScrollViewer x:Name="SearchPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                          ScrollChanged="Page_ScrollChanged">
                <StackPanel Margin="48,84,32,24">
                    <Border Style="{StaticResource FieldBox}" MaxWidth="560" Height="48"
                            HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Grid Width="560">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="16,0,6,0"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Padding="4,0" FontSize="15" VerticalAlignment="Center"
                                         Background="Transparent" Foreground="{StaticResource TextBrush}"
                                         BorderThickness="0" TextChanged="SearchBox_TextChanged"
                                         AutomationProperties.Name="Search films" />
                                <TextBlock x:Name="SearchHint" Text="Search your films…" FontSize="15"
                                           Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <Button x:Name="ClearSearchBtn" ToolTip="Clear the search and show everything again" Grid.Column="2"
                                    Style="{StaticResource IconButton}" Width="30" Height="30" Margin="4,0,9,0"
                                    Visibility="Collapsed" Click="ClearSearch_Click"
                                    AutomationProperties.Name="Clear search">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SearchHeader" Text="All films, A to Z" Style="{StaticResource RowHeader}" Margin="0,0,0,12" />
                    <ItemsControl x:Name="SearchList" ItemTemplate="{StaticResource GridTile}"
                                  ItemsPanel="{StaticResource GridPanel}" Margin="0,0,-16,0"
                                  Focusable="False" SizeChanged="Grid_SizeChanged" />
                    <TextBlock x:Name="SearchEmpty" Visibility="Collapsed" FontSize="14" Margin="0,10,0,0"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- Nothing to show at all: no folder, no server films, no shortcuts. -->
            <Border x:Name="EmptyState" Style="{StaticResource GlassPanel}" Padding="40,34"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="17" Background="{StaticResource TileTealBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyGlyph" Text="&#xEC50;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="No folder selected" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock x:Name="EmptyText" Text="Choose the folder where your movies live — only video files will be listed."
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="360" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Choose folder" HorizontalAlignment="Center"
                            Margin="0,20,0,0" Click="ChangeFolderBtn_Click" AutomationProperties.Name="Choose folder" />
                </StackPanel>
            </Border>

            <!-- ================= Top bar =================
                 Fixed over every page. The shade behind it fades in once a page
                 scrolls, so rows passing beneath never fight the tab labels. -->
            <Rectangle x:Name="TopShade" Height="112" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F20B0D12" Offset="0" />
                        <GradientStop Color="#D90B0D12" Offset="0.55" />
                        <GradientStop Color="#000B0D12" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="48,16,48,0" Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButton}" Click="HomeBtn_Click"
                        Width="44" Height="44" Background="{StaticResource GlassBarBrush}"
                        BorderBrush="{StaticResource GlassLineBrush}"
                        ToolTip="Back to the start screen" AutomationProperties.Name="Start screen">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                </Button>

                <Border Grid.Column="1" Margin="12,0,0,0" Background="{StaticResource GlassBarBrush}"
                        BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource BarRadius}" Padding="4">
                    <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton x:Name="HomeTab" Style="{StaticResource NavTab}" GroupName="LibraryTabs"
                                     Content="Home" IsChecked="True" Checked="Tab_Checked" Tag="home"
                                     AutomationProperties.Name="Home" />
                        <RadioButton x:Name="FilmsTab" Style="{StaticResource NavTab}" GroupName="LibraryTabs"
                                     Content="Films" Checked="Tab_Checked" Tag="films" Margin="4,0,0,0"
                                     AutomationProperties.Name="Films" />
                        <RadioButton x:Name="MyListTab" Style="{StaticResource NavTab}" GroupName="LibraryTabs"
                                     Content="My List" Checked="Tab_Checked" Tag="mylist" Margin="4,0,0,0"
                                     AutomationProperties.Name="My List" />
                        <RadioButton x:Name="SearchTab" Style="{StaticResource NavTab}" GroupName="LibraryTabs"
                                     Checked="Tab_Checked" Tag="search" Margin="4,0,0,0"
                                     AutomationProperties.Name="Search">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,1,8,0" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <!-- Shown whenever there is a server to ask. -->
                    <Button x:Name="VaultBtn" Style="{StaticResource GhostButton}" Click="VaultBtn_Click"
                            Padding="14,0" Margin="0,0,8,0" Visibility="Collapsed"
                            Background="{StaticResource GlassBarBrush}" BorderBrush="{StaticResource GlassLineBrush}"
                            ToolTip="Re-check the Vault server for films added or removed"
                            AutomationProperties.Name="Refresh Vault library">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="VaultBtnText" Text="Vault" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StreamingBtn" Style="{StaticResource GhostButton}" Click="StreamingBtn_Click"
                            Padding="14,0" Margin="0,0,8,0"
                            Background="{StaticResource GlassBarBrush}" BorderBrush="{StaticResource GlassLineBrush}"
                            ToolTip="Browse a streaming service, or add a title you own"
                            AutomationProperties.Name="Streaming">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Streaming" FontSize="12.5" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       VerticalAlignment="Center" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="ChangeFolderBtn_Click" Padding="14,0"
                            Background="{StaticResource GlassBarBrush}" BorderBrush="{StaticResource GlassLineBrush}"
                            ToolTip="Pick the folder your films are kept in" AutomationProperties.Name="Choose folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC50;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="FolderBtnText" Text="Choose folder" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= Details =================
             A glass sheet over a blurred, dimmed copy of the film's still.
             The blur is live (a BlurEffect on a copy of the image) because the
             sheet is static while it is open; it is collapsed, and so costs
             nothing, the rest of the time. -->
        <Grid x:Name="Details" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" ClipToBounds="True">
            <Rectangle Fill="{StaticResource BgBrush}" />
            <Image x:Name="DetailsBlur" Stretch="UniformToFill" Margin="-80">
                <Image.Effect>
                    <BlurEffect Radius="48" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Rectangle Fill="{StaticResource SheetDimBrush}" MouseLeftButtonDown="DetailsBackdrop_MouseDown" />

            <Border x:Name="Sheet" MaxWidth="900" Margin="48,24" VerticalAlignment="Stretch"
                    Background="{StaticResource GlassSheetBrush}" BorderBrush="{StaticResource GlassLineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource SheetRadius}">
                <Grid>
                    <ScrollViewer x:Name="SheetScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- The sharp still, melting into the sheet. -->
                            <Border x:Name="SheetStill" Height="330" CornerRadius="18,18,0,0"
                                    OpacityMask="{StaticResource SheetStillMaskBrush}" />
                            <StackPanel Margin="40,-96,40,34">
                                <TextBlock x:Name="DetailsTitle" Style="{StaticResource HeroTitle}" FontSize="36" LineHeight="40" />
                                <StackPanel x:Name="DetailsMeta" Orientation="Horizontal" Margin="0,14,0,20" />

                                <WrapPanel>
                                    <Button x:Name="DetailsPlayBtn" Style="{StaticResource HeroPrimaryButton}" Margin="0,0,12,12"
                                            Click="DetailsPlay_Click" MinWidth="150">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock x:Name="DetailsPlayText" Text="Play" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StartOverBtn" Style="{StaticResource HeroGlassButton}" Margin="0,0,12,12"
                                            Click="StartOver_Click" AutomationProperties.Name="Start over">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="Start over" />
                                        </StackPanel>
                                    </Button>
                                    <!-- + when off the list, a tick when on it. -->
                                    <Button x:Name="MyListBtn" Style="{StaticResource HeroGlassButton}" Margin="0,0,12,12"
                                            Click="MyListToggle_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="MyListGlyph" Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock x:Name="MyListText" Text="My List" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- How far in, for a film that is under way. -->
                                <StackPanel x:Name="DetailsProgress" Orientation="Horizontal" Margin="0,0,0,14">
                                    <ProgressBar x:Name="DetailsProgressBar" Style="{StaticResource TileProgress}"
                                                 Width="280" Margin="0" VerticalAlignment="Center" Height="4" />
                                    <TextBlock x:Name="DetailsLeftText" FontSize="12.5" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel x:Name="DetailsCaptions" Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xED1E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="English captions available — turn them on from the player"
                                               FontSize="13" Margin="10,0,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Facts, two columns of label and value, built in code. -->
                                <Grid x:Name="DetailsFacts" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <TextBlock x:Name="MoreHeader" Text="More from your vault" Style="{StaticResource RowHeader}"
                                           Margin="0,26,0,12" />
                                <ItemsControl x:Name="MoreList" ItemTemplate="{StaticResource SmallTile}"
                                              ItemsPanel="{StaticResource GridPanel}" Focusable="False" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" Margin="0,14,14,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="DetailsClose_Click"
                            Background="{StaticResource GlassBarBrush}" BorderBrush="{StaticResource GlassLineBrush}"
                            ToolTip="Close (Esc)" AutomationProperties.Name="Close details">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
