<UserControl x:Class="VideoPlayer.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A launcher, laid out like a television's home screen: a big title and
         the time across the top, then rows of tiles on smoked glass, each an
         icon square over a label. The wallpaper is the shell's, so the film
         you were last looking at in the library is still behind this. -->
    <Grid Margin="48,18,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock x:Name="Greeting" Text="Welcome" FontSize="15"
                           Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,2" />
                <TextBlock Text="Home" Style="{StaticResource PageTitle}" FontSize="42" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock x:Name="ClockText" Text="" FontSize="34" FontWeight="Light"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateText" Text="" FontSize="12.5"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                </StackPanel>
                <!-- Account chip: sign in, or show who's signed in. Optional — the app
                     works fully signed out; this only enables cross-device sync. -->
                <Button x:Name="AccountBtn" ToolTip="Sign in to sync your library and watch with friends"
                        Style="{StaticResource GhostButton}" Padding="14,9" VerticalAlignment="Center"
                        Click="AccountBtn_Click" AutomationProperties.Name="Account">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock x:Name="AccountLabel" Text="Sign in" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="-8,26,-8,0" Padding="8,4,8,0">
            <StackPanel>
                <TextBlock Text="Watch" Style="{StaticResource SectionLabel}" />
                <WrapPanel>
                    <Button x:Name="SoloBtn" Style="{StaticResource LaunchTile}" Width="300" Padding="24,26"
                            Margin="0,0,18,18" Click="SoloBtn_Click"
                            ToolTip="Browse your folder and the Vault server, and play anything"
                            AutomationProperties.Name="Watch Solo">
                        <StackPanel>
                            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource TileBlueBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Watch Solo" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,5" />
                            <TextBlock Text="Browse your films and play any of them"
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PartyBtn" Style="{StaticResource LaunchTile}" Width="300" Padding="24,26"
                            Margin="0,0,18,18" Click="PartyBtn_Click"
                            ToolTip="Host a room and watch the same film together, in sync"
                            AutomationProperties.Name="Watch Party">
                        <StackPanel>
                            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource TileVioletBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Watch Party" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,5" />
                            <TextBlock Text="Host a session and watch together with friends"
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock Text="Your setup" Style="{StaticResource SectionLabel}" Margin="2,14,0,12" />
                <WrapPanel>
                    <Button Style="{StaticResource LaunchTile}" Width="196" Padding="16,20" Margin="0,0,18,18"
                            Click="FilmsBtn_Click" ToolTip="Choose where your films are served from — this PC, your own server, or nowhere"
                            AutomationProperties.Name="Where your films live">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource TileTealBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xEC50;" FontFamily="{StaticResource IconFont}" FontSize="25"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Your films" FontSize="14.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,13,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Friends need an account to exist at all, so the tile does too. -->
                    <Button x:Name="FriendsBtn" Style="{StaticResource LaunchTile}" Width="196" Padding="16,20"
                            Margin="0,0,18,18" Click="FriendsBtn_Click" Visibility="Collapsed"
                            ToolTip="Add friends so you can invite them to a party in one tap"
                            AutomationProperties.Name="Friends">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource TileAmberBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8FA;" FontFamily="{StaticResource IconFont}" FontSize="23"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Friends" FontSize="14.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,13,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource LaunchTile}" Width="196" Padding="16,20" Margin="0,0,18,18"
                            Click="SettingsBtn_Click" ToolTip="Audio output and where your films come from"
                            AutomationProperties.Name="Settings">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource TileGreyBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="23"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Settings" FontSize="14.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,13,0,0" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="VersionText" Grid.Row="2" Text="" FontSize="11"
                   Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
