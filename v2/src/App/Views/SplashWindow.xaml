<Window x:Class="VideoPlayer.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Movies"
        Width="440" Height="300"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}">
    <!-- The home screen's dusk in miniature, so the app opens onto the same
         sky its windows are drawn on. -->
    <Border CornerRadius="22" BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1">
        <Border.Background>
            <RadialGradientBrush Center="0.8,0.15" GradientOrigin="0.8,0.15" RadiusX="0.9" RadiusY="1.1">
                <GradientStop Color="#3A2219" Offset="0" />
                <GradientStop Color="#141822" Offset="0.55" />
                <GradientStop Color="#0B0D12" Offset="1" />
            </RadialGradientBrush>
        </Border.Background>
        <Grid Margin="32,28">
            <StackPanel VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource BrandBrush}">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="26"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Vault Movies" FontSize="25" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />

                <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,10,0,0" />

                <ProgressBar x:Name="Progress" Height="4" Margin="40,20,40,0"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" IsIndeterminate="True" />

                <!-- Only ever shown when an update actually exists. -->
                <StackPanel x:Name="UpdatePrompt" Visibility="Collapsed" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryButton}" Padding="18,9"
                                Content="Update now" Click="Update_Click"
                                AutomationProperties.Name="Update now" />
                        <Button x:Name="SkipBtn" Style="{StaticResource GhostButton}" Padding="16,9" Margin="10,0,0,0"
                                Content="Not now" Click="Skip_Click"
                                AutomationProperties.Name="Not now" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
