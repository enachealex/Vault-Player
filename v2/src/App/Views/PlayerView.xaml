<UserControl x:Class="VideoPlayer.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black">
    <UserControl.Resources>
        <!-- Everything on the bars is a quiet button that only becomes glass
             under the pointer, so at rest the film has nothing but icons over
             it. Play is the exception, and is solid white. -->
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <!-- The panels that float over the picture: the pause card, chat, the
             shortcut list, casting. -->
        <Style x:Key="OverlayCard" TargetType="Border" BasedOn="{StaticResource GlassBar}">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="30,26" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- One cell, and the video fills it. The bars used to sit in their own
         Auto-height rows above and below, which meant hiding them on idle
         collapsed those rows, the star row grew, and the picture resized —
         then resized back the moment the pointer moved. Overlaying them
         instead means showing and hiding chrome cannot touch the video at all.

         They have to live INSIDE the VideoView for that: libVLC hosts the
         picture in a native child window, and WPF siblings of that window are
         drawn underneath it no matter what their z-order says. Only the
         VideoView's own content renders above the video. -->
    <Grid x:Name="RootGrid">
        <vlc:VideoView x:Name="Video" Background="Black">
            <Grid x:Name="VideoOverlay" Background="Transparent">

                <!-- Clicks on the picture land here, on a catcher that sits
                     UNDER everything else in the overlay. Putting the handler on
                     the overlay grid itself meant a press on any panel above it
                     bubbled down and was read as a click on the film — pausing
                     it when somebody reached for the seek bar, or for chat. With
                     the catcher underneath, each panel swallows its own area for
                     free, and the next panel added cannot reintroduce the bug. -->
                <Border Background="Transparent" MouseLeftButtonDown="VideoArea_MouseDown" />

                <!-- Pausing a party brings the lobby back: the room code and who
                     is in it are exactly what you need when someone is late or
                     dropped out. Hidden again the moment playback resumes. -->
                <Border x:Name="PausedPartyCard" Visibility="Collapsed" Style="{StaticResource OverlayCard}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel MinWidth="300">
                        <TextBlock Text="Paused" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="PausedTitle" Text="" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextBrush}" />

                        <TextBlock Text="Room code" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"
                                   Margin="0,20,0,6" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="PausedCode" Text="" FontSize="32" FontWeight="Bold"
                                       FontFamily="Consolas" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                            <Button x:Name="PausedCopyBtn" Style="{StaticResource IconButton}" Width="36" Height="36"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                    Margin="12,0,0,0" VerticalAlignment="Center" Click="CopyRoomCode_Click"
                                    ToolTip="Copy the room code" AutomationProperties.Name="Copy room code">
                                <TextBlock x:Name="PausedCopyGlyph" Text="&#xE8C8;"
                                           FontFamily="{StaticResource IconFont}" FontSize="13" />
                            </Button>
                        </StackPanel>

                        <TextBlock Text="In the room" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"
                                   Margin="0,20,0,6" />
                        <ItemsControl x:Name="PausedRoster" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="14" Margin="0,2"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"
                                               ContextMenuOpening="PausedRosterItem_MenuOpening">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove from party" Click="KickFromPlayer_Click" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Host toasts (guest joined / pause requests) -->
                <StackPanel x:Name="ToastPanel" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,74,0,0" />

                <!-- Party chat -->
                <Border x:Name="ChatPanel" Visibility="Collapsed" HorizontalAlignment="Right"
                        VerticalAlignment="Stretch" Width="300" Margin="0,74,16,150"
                        Style="{StaticResource OverlayCard}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0,0,8">
                            <TextBlock Text="Party chat" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="ChatBtn_Click" AutomationProperties.Name="Hide chat"
                                    ToolTip="Hide chat">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ChatList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" Margin="4,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox Grid.Row="2" x:Name="ChatInput" Margin="0,10,0,0" FontSize="13"
                                 KeyDown="ChatInput_KeyDown"
                                 AutomationProperties.Name="Chat message" />
                    </Grid>
                </Border>

                <Border x:Name="CastBanner" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Style="{StaticResource OverlayCard}">
                    <StackPanel>
                        <Border Width="60" Height="60" CornerRadius="16" Background="{StaticResource TileBlueBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xEC15;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="CastBannerText" Text="Casting" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="The movie is playing on the device — controls below still work."
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Every shortcut, on demand. The keys existed but nothing
                     in the product ever said so. -->
                <Border x:Name="ShortcutHelp" Visibility="Collapsed" Style="{StaticResource OverlayCard}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Keyboard shortcuts" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />
                        <UniformGrid Columns="2">
                            <TextBlock Text="Space / K" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Play or pause" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="&#8592; &#8594;" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Back / forward 5 seconds" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="J / L" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Back / forward 10 seconds" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="Page Up / Down" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Back / forward a minute" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="0 &#8211; 9" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Jump to that tenth of the film" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="Home / End" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Start / end" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="&#8593; &#8595;" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Volume" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="M" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Mute" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="[ / ]" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Slower / faster" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="Ctrl+0" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Normal speed" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="C / A" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Subtitles / audio track" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="N / P" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Next / previous film" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="F / F11" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Fullscreen" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="Ctrl+T" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Keep window on top" Style="{StaticResource ShortcutWhat}" />
                            <TextBlock Text="Esc" Style="{StaticResource ShortcutKey}" />
                            <TextBlock Text="Leave fullscreen, or the film" Style="{StaticResource ShortcutWhat}" />
                        </UniformGrid>
                        <TextBlock Text="? or F1 closes this" FontSize="11.5" Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Top: a shade rather than a box, fading into the picture, with
                     the way out on the left and the session's toggles on the right. -->
                <Grid x:Name="TopBar" VerticalAlignment="Top">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C0000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <!-- The shade spans the window; its contents take the control bar's
                         width and inset, so the back button and Autoplay sit over the
                         bar's two ends instead of out in the corners. -->
                    <Grid MaxWidth="1180" Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource IconButton}" Click="BackBtn_Click"
                                Width="42" Height="42" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                ToolTip="Back to your library (Esc)"
                                AutomationProperties.Name="Back to library" Margin="0,14,6,30">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,22,16,0">
                            <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Guests only: makes it obvious you're a passenger, not the driver. -->
                            <Border x:Name="SharedScreenBadge" Visibility="Collapsed" Margin="12,0,0,0"
                                    Background="{StaticResource AccentSoftBrush}" CornerRadius="{StaticResource ChipRadius}" Padding="11,4"
                                    BorderBrush="#66005ED9" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource AccentLightBrush}" />
                                    <TextBlock x:Name="SharedScreenText" Text="" FontSize="11.5" Margin="7,0,0,0"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,14,0,0">
                            <!-- Chat lives up here with Autoplay: both are about the session
                                 rather than the playhead, unlike everything in the bottom bar. -->
                            <Button x:Name="ChatBtn" ToolTip="Show or hide the party chat" Style="{StaticResource GhostButton}"
                                    Click="ChatBtn_Click" AutomationProperties.Name="Party chat"
                                    Visibility="Collapsed" Margin="0,0,8,0" Padding="14,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Chat" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AutoplayBtn" ToolTip="When a film ends, start the next one in this folder automatically" Style="{StaticResource GhostButton}"
                                    Click="AutoplayBtn_Click" AutomationProperties.Name="Autoplay"
                                    Padding="14,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AutoplayGlyph" Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Autoplay" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Casting is broken and hidden until it is fixed. The code behind
                             it is untouched, so restoring this is a one-line change. -->
                        <Button x:Name="CastBtn" ToolTip="Play this on a TV or speaker on your network instead" Grid.Column="3" Style="{StaticResource GhostButton}" Click="CastBtn_Click"
                                AutomationProperties.Name="Cast to device" Visibility="Collapsed"
                                VerticalAlignment="Top" Margin="8,14,0,0" Padding="14,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CastGlyph" Text="&#xEC15;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="CastLabel" Text="Cast" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Bottom: one floating pane of glass holding the timeline and
                     the transport, inset from the edges like a television's dock.
                     Capped in width so on a big screen the controls stay together
                     instead of drifting to opposite corners. -->
                <Border x:Name="ControlBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        MaxWidth="1180" Margin="18,0,18,18" Padding="18,10,18,10"
                        Style="{StaticResource GlassBar}" CornerRadius="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Seek row -->
                        <Grid Grid.Row="0" Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Tabular figures, so the clock does not shuffle sideways
                                 as the digits change under it. -->
                            <TextBlock x:Name="TimeText" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0"
                                       FontSize="13" Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource TextBrush}" Text="0:00" />
                            <Slider x:Name="Seek" ToolTip="Drag to jump anywhere in the film, or use the left and right arrow keys" Grid.Column="1" VerticalAlignment="Center" Maximum="1000" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="13" Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource TextMutedBrush}" Text="0:00" />
                            <!-- PlacementTarget is set in code, like VolumePopup's. -->
                            <Popup x:Name="ScrubPopup" Placement="Relative"
                                   AllowsTransparency="True" IsHitTestVisible="False">
                                <!-- Padding and the frame's width are what ShowScrubPopupAt
                                     centres against; change them together. -->
                                <Border Background="#E6101217" CornerRadius="12" Padding="6"
                                        BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Frame preview. Collapsed until one is ready, so the
                                             popup stays a plain timestamp for remote streams
                                             and while ffmpeg is still working. -->
                                        <Border x:Name="ScrubThumbBorder" Visibility="Collapsed" CornerRadius="7"
                                                ClipToBounds="True" Margin="0,0,0,5">
                                            <Image x:Name="ScrubThumb" Width="200" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock x:Name="ScrubText" Foreground="White" FontSize="12.5"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="4,0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Buttons row: transport centred, utilities right, codec info left -->
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <!-- 2, like the seek row, so this starts under the clock. -->
                            <TextBlock x:Name="InfoText" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                       FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PrevBtn" ToolTip="Previous film in this folder (P)" Style="{StaticResource BarButton}"
                                        Click="PrevBtn_Click" AutomationProperties.Name="Previous">
                                    <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                </Button>
                                <Button x:Name="Back10Btn" ToolTip="Back 10 seconds (J, or the left arrow for 5)" Style="{StaticResource BarButton}"
                                        Click="Back10_Click" AutomationProperties.Name="Back 10 seconds">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="10" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PlayBtn" ToolTip="Play or pause (Space)" Style="{StaticResource PlayButton}" Margin="10,0"
                                        Click="PlayBtn_Click" AutomationProperties.Name="Play or pause">
                                    <TextBlock x:Name="PlayGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="17" />
                                </Button>
                                <Button x:Name="Fwd10Btn" ToolTip="Forward 10 seconds (L, or the right arrow for 5)" Style="{StaticResource BarButton}"
                                        Click="Fwd10_Click" AutomationProperties.Name="Forward 10 seconds">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="10" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="&#xEB9D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NextBtn" ToolTip="Next film in this folder (N)" Style="{StaticResource BarButton}"
                                        Click="NextBtn_Click" AutomationProperties.Name="Next">
                                    <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ChaptersBtn" ToolTip="Jump to a chapter, or save your own bookmark here" Style="{StaticResource BarButton}"
                                        Click="ChaptersBtn_Click" AutomationProperties.Name="Chapters">
                                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                                <Button x:Name="AudioBtn" ToolTip="Choose which audio track to listen to (A)" Style="{StaticResource BarButton}"
                                        Click="AudioBtn_Click" AutomationProperties.Name="Audio track">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                                <Button x:Name="SubsBtn" ToolTip="Subtitles: choose a track, or turn them off (C)" Style="{StaticResource BarButton}"
                                        Click="SubsBtn_Click" AutomationProperties.Name="Subtitles">
                                    <TextBlock x:Name="SubsGlyph" Text="CC" FontSize="12" FontWeight="Bold" />
                                </Button>
                                <Button x:Name="RateBtn" ToolTip="Playback speed (] faster, [ slower, Ctrl+0 back to normal)" Style="{StaticResource BarButton}"
                                        Click="RateBtn_Click" AutomationProperties.Name="Playback speed">
                                    <TextBlock x:Name="RateText" Text="1×" FontSize="12" FontWeight="Bold" />
                                </Button>
                                <Button x:Name="VolumeBtn" ToolTip="Volume" Style="{StaticResource BarButton}"
                                        Click="VolumeBtn_Click" AutomationProperties.Name="Volume">
                                    <TextBlock x:Name="MuteGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                                <!-- StaysOpen=False closes it on any click elsewhere.
                                     PlacementTarget is set in code, not with ElementName: the
                                     VideoView moves everything in here into a window of its own,
                                     where ElementName finds nothing, and a popup without a target
                                     opens against its parent - here, the left end of this row. -->
                                <Popup x:Name="VolumePopup"
                                       Placement="Top" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border x:Name="VolumePopupBody" Background="{StaticResource MenuBrush}"
                                            CornerRadius="14" Padding="8,14"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="VolumeReadout" Text="100" FontSize="11.5"
                                                       Typography.NumeralAlignment="Tabular"
                                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <!-- IsMoveToPointEnabled gives click-to-position; the custom
                                                 drag helper used elsewhere is horizontal-only. -->
                                            <Slider x:Name="VolumeSlider" ToolTip="Volume — the up and down arrow keys do this too" Orientation="Vertical" Height="120"
                                                    Maximum="100" IsMoveToPointEnabled="True"
                                                    HorizontalAlignment="Center"
                                                    AutomationProperties.Name="Volume level" />
                                            <Button x:Name="MuteBtn" ToolTip="Mute (M)" Style="{StaticResource IconButton}"
                                                    Width="32" Height="32" Margin="0,10,0,0" HorizontalAlignment="Center"
                                                    Click="MuteBtn_Click" AutomationProperties.Name="Mute">
                                                <TextBlock x:Name="MuteToggleGlyph" Text="&#xE74F;"
                                                           FontFamily="{StaticResource IconFont}" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Button x:Name="FullscreenBtn" ToolTip="Fill the screen (F, or double-click the picture)" Style="{StaticResource BarButton}"
                                        Click="FullscreenBtn_Click" AutomationProperties.Name="Fullscreen">
                                    <TextBlock x:Name="FullscreenGlyph" Text="&#xE740;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</UserControl>
