<Window x:Class="VideoPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:VideoPlayer.App.Views"
        Title="Vault Movies"
        Icon="Assets/app.ico"
        Width="1280" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        StateChanged="Window_StateChanged">

    <!-- Custom chrome: keeps native drag / snap / resize behaviour but lets us
         draw the title bar ourselves. CaptionHeight must match the title bar
         row, or the draggable strip won't line up with what's on screen. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The wallpaper, under the title bar as well as the content: the
                 window is one canvas, not a strip of chrome above a canvas. -->
            <views:AmbientBackdrop x:Name="Ambient" Grid.RowSpan="2" />

            <Border x:Name="TitleBar" Grid.Row="0" Height="38"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource TitleBarLineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand mark + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <!-- The app icon in miniature. -->
                        <Border Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource BrandBrush}">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="1,0,0,0" />
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Vault Movies" FontSize="12.5"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- Context line (e.g. the movie currently playing) -->
                    <TextBlock x:Name="TitleSubtext" Grid.Column="1" Text="" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="14,0"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="PinBtn" Style="{StaticResource CaptionButton}"
                                Click="PinBtn_Click" Content="&#xE718;" FontSize="15"
                                ToolTip="Keep this window on top of other apps (Ctrl+T)"
                                AutomationProperties.Name="Keep on top" />
                        <Button x:Name="SettingsBtn" Style="{StaticResource CaptionButton}"
                                Click="SettingsBtn_Click" Content="&#xE713;" FontSize="16"
                                ToolTip="Settings" AutomationProperties.Name="Settings" />
                        <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}"
                                Click="MinBtn_Click" Content="&#xE921;"
                                ToolTip="Minimise" AutomationProperties.Name="Minimise" />
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}"
                                Click="MaxBtn_Click" Content="&#xE922;"
                                ToolTip="Maximise" AutomationProperties.Name="Maximise" />
                        <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                                Click="CloseBtn_Click" Content="&#xE8BB;"
                                ToolTip="Close" AutomationProperties.Name="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="Host" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
