<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Protocol\VideoPlayer.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The webOS package served at /tv/app.ipk. Built by scripts/pack-webos.ps1
       and committed, so a deploy does not need the LG tooling present. -->
  <ItemGroup>
    <None Include="tv/vaultmovies.ipk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('tv/vaultmovies.ipk')" />
  </ItemGroup>

  <!-- Home-screen icons for the /watch web app. Made by scripts/make-vault-icons.js. -->
  <ItemGroup>
    <None Include="watch/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
