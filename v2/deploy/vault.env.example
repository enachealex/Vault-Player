# Account secrets for the Vault backend. Copy to deploy/vault.env on the
# server (which is gitignored) and fill in. Never commit the real file.

# Signing key for access tokens. Generate a strong one:
#   openssl rand -base64 48
VAULT_JWT_SECRET=

# Transactional email (Gmail SMTP with an app password, or any provider).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vaultjump.noreply@gmail.com
SMTP_PASS=
SMTP_FROM=vaultjump.noreply@gmail.com
SMTP_FROM_NAME=Vault Movies

# ---- The server's own film library -----------------------------------------
# One setting for this, and it does NOT belong in this file: MEDIA_DIR names a
# path on the HOST, and compose only substitutes variables it reads from
# deploy/.env — values here are handed to the container instead, which is too
# late to decide what gets mounted. So put it alongside PARTY_DOMAIN:
#
#     # deploy/.env
#     MEDIA_DIR=/mnt/media
#
# It is bind-mounted read-only at /media, where VAULT_MEDIA points.
