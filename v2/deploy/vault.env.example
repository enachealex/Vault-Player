# Account secrets for the Vault backend. Copy to deploy/vault.env on the
# server (which is gitignored) and fill in. Never commit the real file.

# Signing key for access tokens. Generate a strong one:
#   openssl rand -base64 48
VAULT_JWT_SECRET=

# Transactional email (Gmail SMTP with an app password, or any provider).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vaultjump.noreply@gmail.com
SMTP_PASS=
SMTP_FROM=vaultjump.noreply@gmail.com
SMTP_FROM_NAME=Vault Movies

# ---- The server's own film library -----------------------------------------
# Two settings for this, and NEITHER belongs in this file: both name paths on
# the HOST, and compose only substitutes variables it reads from deploy/.env —
# values here are handed to the container instead, which is too late to decide
# what gets mounted. So put them alongside PARTY_DOMAIN:
#
#     # deploy/.env
#     MEDIA_DIR=/mnt/media
#     HLS_CACHE_DIR=/mnt/media/.vault-hls
#
# MEDIA_DIR is bind-mounted read-only at /media, where VAULT_MEDIA points.
#
# HLS_CACHE_DIR holds the browser-playable copies made for phones and
# televisions. Give it a disk with room: each cached film is roughly the size of
# the original, and the default ceiling is 50 GB (VAULT_HLS_CACHE_GB). It is
# pure cache — deleting it costs a remux and nothing else — so it belongs on
# whatever disk has space rather than beside the database.
